import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.graphics.FunkinSprite;
import funkin.Paths;

class PicoShootNotesDsides extends Module
{
var Direction:String;
    function new(){
        super("PicoShootD");
    }

function onNoteMiss(event) {
    if (event.note.noteData.kind == "shoot") 
        PlayState.instance.health -= 0.4; //Player takes damage when miss a note
}


    function onNoteIncoming(event)
        {
            if(event.note.noteData.kind == 'shoot')
                {
                    if (event.note.noteData.kind == "shoot") {
                        event.note.frames = Paths.getSparrowAtlas('dside/Blammed');
                        event.note.animation.addByPrefix('greenScroll', 'green0');
                        event.note.animation.addByPrefix('redScroll', 'red0');
                        event.note.animation.addByPrefix('blueScroll', 'blue0');
                        event.note.animation.addByPrefix('purpleScroll', 'purple0');
            
                        event.note.updateHitbox();
            
                        var color:String;
            
                        if(event.note.noteData.data % 4 == 0)
                            color = "purpleScroll";
                        if(event.note.noteData.data % 4 == 1)
                            color = "blueScroll";                            
                        if(event.note.noteData.data % 4 == 2)
                            color = "greenScroll";                           
                        if(event.note.noteData.data % 4 == 3)
                            color = "redScroll";
            
                        event.note.animation.play(color);
                }
        }

    }
}


